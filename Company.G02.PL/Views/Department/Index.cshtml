
@model IEnumerable<Department>
@{
    ViewData["Title"] = "Index";
}

<h1>All Departments</h1>

<br />
<br />
<a asp-action="Create" class=" btn-primary">Create Department</a>

<br />
<br />

@if(Model.Count() > 0)
{
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Name</th>
                <th>date Of Creation</th>
                <th>Details</th>
                <th>Update</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbode>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td>@item.CreateAt</td>
                    <partial name="_ButtonPartialView" model="@item.Id.ToString()" />
                </tr>
            }
        </tbode>
    </table>
}
else
{
    <div class="mt-4 alert-info">
        <h4>
            There are no Department :(
        </h4>
    </div>
}
